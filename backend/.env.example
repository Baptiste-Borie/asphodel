DB_FILE_NAME=file:./data/asphodel.sqlite
SCRYFALL_USER_AGENT=Asphodel/0.1
SCRYFALL_BULK_PATH=data/scryfall-oracle-cards.jsonl.gz

# Voice transcription (whisper.cpp, see backend/src/voice/whisper-transcription-service.ts).
# Defaults below are tuned for short push-to-talk gameplay commands on modest homelab CPUs;
# override any of them per-deployment.
# WHISPER_MODEL=tiny
# WHISPER_MODEL_PATH=./.whisper-models
# WHISPER_LANGUAGE=fr
# WHISPER_THREADS=4
# WHISPER_AUDIO_CTX=512
# WHISPER_BEAM_SIZE=1
# WHISPER_BEST_OF=1
